<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <!-- Fondo blanco -->
  <rect width="400" height="400" fill="#ffffff"/>
  
  <!-- Marco -->
  <rect x="20" y="20" width="360" height="360" fill="none" stroke="#d4af37" stroke-width="4" rx="10"/>
  
  <!-- Icono de QR placeholder -->
  <g transform="translate(150, 140)">
    <rect x="0" y="0" width="30" height="30" fill="#333"/>
    <rect x="35" y="0" width="30" height="30" fill="#333"/>
    <rect x="70" y="0" width="30" height="30" fill="#333"/>
    <rect x="0" y="35" width="30" height="30" fill="#333"/>
    <rect x="70" y="35" width="30" height="30" fill="#333"/>
    <rect x="0" y="70" width="30" height="30" fill="#333"/>
    <rect x="35" y="70" width="30" height="30" fill="#333"/>
    <rect x="70" y="70" width="30" height="30" fill="#333"/>
  </g>
  
  <!-- Texto -->
  <text x="200" y="280" font-family="Arial, sans-serif" font-size="18" fill="#666" text-anchor="middle">
    Código QR Placeholder
  </text>
  <text x="200" y="310" font-family="Arial, sans-serif" font-size="14" fill="#999" text-anchor="middle">
    Reemplaza con QR real
  </text>
  <text x="200" y="340" font-family="Arial, sans-serif" font-size="12" fill="#ccc" text-anchor="middle">
    Ver: /assets/qr/README.md
  </text>
</svg>
